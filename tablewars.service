# TABLE WARS - Systemd Service File
# For non-Docker deployments
#
# Installation:
#   sudo cp tablewars.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable tablewars
#   sudo systemctl start tablewars
#
# Management:
#   sudo systemctl status tablewars
#   sudo systemctl restart tablewars
#   sudo systemctl stop tablewars
#   sudo journalctl -u tablewars -f

[Unit]
Description=Table Wars WebSocket Server
After=network.target postgresql.service
Wants=postgresql.service
# Restart-storm protection. These MUST live in [Unit] — modern systemd ignores
# StartLimitBurst/StartLimitIntervalSec when placed in [Service], which left the
# rate limit silently disabled (audit deploy-2026-06-06).
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=tablewars
Group=tablewars
WorkingDirectory=/opt/table-wars-puck/server

# Environment
EnvironmentFile=/opt/table-wars-puck/.env

# Start command using gunicorn with eventlet worker
ExecStart=/opt/table-wars-puck/server/venv/bin/gunicorn \
    --worker-class eventlet \
    --workers 1 \
    --bind 0.0.0.0:5001 \
    --timeout 120 \
    --access-logfile /var/log/tablewars/access.log \
    --error-logfile /var/log/tablewars/error.log \
    --log-level info \
    --chdir /opt/table-wars-puck/server \
    app:app

# Restart policy (StartLimit* moved to [Unit] above)
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/tablewars /opt/table-wars-puck/server/data

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

[Install]
WantedBy=multi-user.target
