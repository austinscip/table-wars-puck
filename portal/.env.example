# Copy to .env.local (gitignored) and fill in. Both values are PUBLIC by design
# (anon key is safe to expose; row access is enforced by Supabase RLS). Never
# put the Supabase SERVICE ROLE key in this app — it bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
