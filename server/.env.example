# TABLE WARS - Environment Configuration
#
# Copy this file to .env and fill in your values
# The .env file should NOT be committed to git
#
# Generate secure SECRET_KEY with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Leave DATABASE_URL empty for local development (uses SQLite)
# Set DATABASE_URL for production (uses PostgreSQL)
#
# Docker format: postgresql://tablewars_user:DB_PASSWORD@postgres:5432/tablewars_prod
# Remote format: postgresql://username:password@hostname:port/database

DATABASE_URL=

# Database password (used by Docker Compose)
DB_PASSWORD=change_me_in_production

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================

# Flask secret key - REQUIRED for production!
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change_this_secret_key_in_production

# Debug mode (set to False in production)
DEBUG=True

# Server host and port
HOST=0.0.0.0
PORT=5001

# Flask environment (development or production)
FLASK_ENV=development

# ============================================================================
# DOMAIN & SSL (Production Only)
# ============================================================================

# Your domain name (for SSL certificate and CORS)
# DOMAIN=yourdomain.com

# ============================================================================
# OPTIONAL: MONITORING & LOGGING
# ============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# ============================================================================
# OPTIONAL: FIRMWARE OTA UPDATES
# ============================================================================

# Base URL for firmware downloads (defaults to current domain)
# FIRMWARE_BASE_URL=https://yourdomain.com/firmware

# ============================================================================
# OPTIONAL: ANALYTICS
# ============================================================================

# Google Analytics tracking ID
# GA_TRACKING_ID=UA-XXXXXXXXX-X
