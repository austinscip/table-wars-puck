docker-compose.override.yml

# Piper TTS voice models (large .onnx weights — download via generate_narration.py)
server/voices/piper/*.onnx

# Kokoro TTS model files (337MB, downloaded by scripts/sample_kokoro.py)
server/voices/kokoro/kokoro-v1.0.onnx
server/voices/kokoro/voices-v1.0.bin
server/voices/kokoro/samples/

# Piper-era narration backup (~118MB) — superseded by am_michael Kokoro
# MP3s on disk. Kept locally for A/B reference; never commit.
server/static/games/speed-pyramid/audio/questions/.piper_backup/

# Slice I — runtime state snapshot (crash-recovery), regenerated on
# every POST by state_persistence.py
server/state_snapshot.json
server/state_snapshot.json.tmp

