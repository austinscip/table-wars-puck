; Copy this file to secrets.ini (which is gitignored) and fill in real values.
; platformio.ini pulls it in via `extra_configs = secrets.ini` and references
; ${wifi.ssid} / ${wifi.pass} / ${ota.auth} in the build/upload flags.
[wifi]
ssid = YOUR_WIFI_SSID
pass = YOUR_WIFI_PASSWORD

[ota]
; ArduinoOTA upload password for the legacy esp32_ota / puckN_ota envs.
auth = changeme
