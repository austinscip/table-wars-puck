# Table Wars runtime environment — copy to /etc/tablewars/tablewars.env and fill in.
# See docs/audit/manual-items-2026-06-05.md for what each does.

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres   # Supabase Postgres
LOCATION_ID=00000000-0000-0000-0000-000000000000             # this venue's location id
SECRET_KEY=change-me

# --- Security (set in prod) ---
PUCK_JWT_SECRET=                 # >=32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUPABASE_JWT_SECRET=             # Supabase project JWT secret (for TV match tokens)
PUCK_AUTOPROVISION=0             # lock the fleet (no self-registration)
SCRUB_SECRETS_AFTER_BOOT=1       # drop secrets from env after boot
CORS_ALLOWED_ORIGINS=https://portal.example.com,https://tv.example.com

# --- Durability / scale (optional) ---
REDIS_URL=                       # enables durable match store + restart recovery

# --- Observability (optional) ---
SENTRY_DSN=
ENVIRONMENT=production
LOG_LEVEL=INFO
